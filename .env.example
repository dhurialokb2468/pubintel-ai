# PubIntel AI - Environment Configuration

# Official YouTube Data API v3 Key (Obtain from https://console.cloud.google.com/)
YOUTUBE_API_KEY=your_youtube_api_key_here
NEXT_PUBLIC_YOUTUBE_API_KEY=your_youtube_api_key_here

# Official Google Books API Key
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# Udemy REST API Credentials (https://www.udemy.com/user/edit-api-clients/)
UDEMY_CLIENT_ID=your_udemy_client_id
UDEMY_CLIENT_SECRET=your_udemy_client_secret

# Amazon Product Advertising API 5.0
AMAZON_ACCESS_KEY=your_amazon_access_key
AMAZON_SECRET_KEY=your_amazon_secret_key
AMAZON_ASSOCIATE_TAG=pubintel-20
